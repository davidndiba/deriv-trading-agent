# Deriv app registered at https://api.deriv.com
APP_ID=
# API token scoped to read + trade ONLY (never withdrawals/transfers).
# Generate this against a DEMO account first.
API_TOKEN=

# demo | live  -- switching to live also requires a second interactive
# confirmation at runtime. This flag alone does not enable real money.
ENV=demo

# Fraction of balance risked per trade (0.01 = 1%).
RISK_PER_TRADE_PCT=0.01

# Fraction of balance that halts new proposals for the rest of the day
# once realized loss exceeds it (0.03 = 3%).
DAILY_LOSS_LIMIT_PCT=0.03

# Comma-separated MM-DD dates (any year) where stake is auto-halved.
BLACKOUT_DATES=12-24,12-25,12-26,12-31,01-01,01-02

# Comma-separated Deriv symbols to analyze.
SYMBOLS=frxEURUSD,frxXAUUSD,1HZ100V

# Phase 4 hardening (optional; sane defaults if left unset).
MAX_CONCURRENT_CONTRACTS=3
MAX_CORRELATED_SAME_DIRECTION=1

# Telegram alerting (optional — notify-only, never approves trades).
# Leave both blank to disable. Create a bot via @BotFather, then message
# it once and use https://api.telegram.org/bot<token>/getUpdates to find
# your chat_id.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Phase 5 real-money cutover (scripts/run_phase5_live_trading.py ONLY —
# every other script refuses to run at all if ENV=live).
# Hard stake cap in USD regardless of risk-% sizing ("smallest viable
# stake first").
LIVE_MAX_STAKE_USD=1.0
# Minimum days of demo trading history (by earliest closed demo trade)
# before run_phase5_live_trading.py will even show its confirmation
# prompt. No override flag exists — see docs/DECISIONS.md.
LIVE_MIN_DEMO_SOAK_DAYS=14
# Minimum number of closed demo trades on record, same gate as above.
LIVE_MIN_DEMO_TRADES=20
